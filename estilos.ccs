/* =========================
   VARIABLES
========================= */

:root {

    --black: #080808;
    --dark: #101010;
    --dark-2: #171717;

    --white: #ffffff;
    --gray: #a7a7a7;

    --gold: #c9a45c;
    --gold-light: #e1c27a;

    --border: rgba(255,255,255,0.12);

    --title: "Playfair Display", serif;
    --body: "DM Sans", sans-serif;

}


/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    background: var(--black);

    color: var(--white);

    font-family: var(--body);

    line-height: 1.6;
}


/* =========================
   IMÁGENES
========================= */

img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    display: block;
}


/* =========================
   HEADER
========================= */

.header {

    position: fixed;

    top: 0;

    left: 0;

    width: 100%;

    height: 80px;

    padding: 0 7%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    background: rgba(8,8,8,0.85);

    backdrop-filter: blur(15px);

    border-bottom: 1px solid var(--border);

    z-index: 1000;
}


.logo {

    width: 60px;

    height: 60px;
}


.nav {

    display: flex;

    gap: 35px;
}


.nav a {

    color: var(--white);

    text-decoration: none;

    font-size: 14px;

    transition: 0.3s;
}


.nav a:hover {

    color: var(--gold);
}


/* =========================
   BOTONES
========================= */

.btn {

    display: inline-block;

    padding: 14px 30px;

    background: var(--gold);

    color: #080808;

    text-decoration: none;

    border: 1px solid var(--gold);

    font-weight: 700;

    transition: 0.3s;

    cursor: pointer;
}


.btn:hover {

    background: transparent;

    color: var(--gold);

    transform: translateY(-3px);
}


.btn-small {

    padding: 10px 22px;

    font-size: 13px;
}


.btn-outline {

    background: transparent;

    color: white;

    border-color: white;
}


.btn-outline:hover {

    background: white;

    color: black;
}


/* =========================
   HERO
========================= */

.hero {

    min-height: 100vh;

    display: flex;

    align-items: center;

    position: relative;

    background-image:
    linear-gradient(
        90deg,
        rgba(0,0,0,0.9),
        rgba(0,0,0,0.45)
    ),
    url("../img/portada.jpg");

    background-size: cover;

    background-position: center;
}


.hero-content {

    width: 90%;

    max-width: 1200px;

    margin: auto;

    position: relative;

    z-index: 2;
}


.subtitle,
.section-label {

    color: var(--gold);

    letter-spacing: 4px;

    font-size: 12px;

    font-weight: 700;

    margin-bottom: 20px;
}


.hero h1 {

    font-family: var(--title);

    font-size: clamp(55px, 8vw, 110px);

    line-height: 0.95;

    max-width: 850px;

    margin-bottom: 30px;
}


.hero h1 span {

    color: var(--gold);

    display: block;
}


.hero-text {

    max-width: 500px;

    color: #ddd;

    margin-bottom: 35px;

    font-size: 17px;
}


.hero-buttons {

    display: flex;

    gap: 15px;

    flex-wrap: wrap;
}


.scroll {

    position: absolute;

    bottom: 30px;

    right: 7%;

    font-size: 11px;

    letter-spacing: 3px;

    color: var(--gray);
}


/* =========================
   SECCIONES
========================= */

section {

    padding: 110px 7%;
}


.section-heading {

    text-align: center;

    margin-bottom: 60px;
}


.section-heading h2,
.about h2,
.contact h2 {

    font-family: var(--title);

    font-size: clamp(38px, 5vw, 65px);

    line-height: 1.1;
}


.section-heading h2 span,
.about h2 span,
.contact h2 span {

    color: var(--gold);
}


/* =========================
   ABOUT
========================= */

.about {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    align-items: center;

    background: var(--dark);
}


.section-image {

    height: 600px;

    overflow: hidden;
}


.section-image img {

    transition: 0.6s;
}


.section-image:hover img {

    transform: scale(1.05);
}


.section-content p:not(.section-label) {

    color: var(--gray);

    margin: 25px 0;

    max-width: 550px;
}


.text-link {

    color: var(--gold);

    text-decoration: none;

    font-weight: 700;
}


/* =========================
   SERVICIOS
========================= */

.services {

    background: var(--black);
}


.services-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}


.service-card {

    background: var(--dark-2);

    border: 1px solid var(--border);

    transition: 0.4s;

    overflow: hidden;
}


.service-card:hover {

    transform: translateY(-10px);

    border-color: var(--gold);
}


.service-image {

    height: 350px;

    overflow: hidden;
}


.service-image img {

    transition: 0.6s;
}


.service-card:hover .service-image img {

    transform: scale(1.08);
}


.service-info {

    padding: 30px;
}


.service-info > span {

    color: var(--gold);

    font-size: 12px;

    letter-spacing: 2px;
}


.service-info h3 {

    font-family: var(--title);

    font-size: 28px;

    margin: 10px 0;
}


.service-info p {

    color: var(--gray);

    margin-bottom: 20px;
}


.service-info strong {

    color: var(--gold);

    font-size: 20px;
}


/* =========================
   FRASE
========================= */

.quote {

    min-height: 450px;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    background:
    linear-gradient(
        rgba(0,0,0,0.8),
        rgba(0,0,0,0.8)
    ),
    url("../img/portada.jpg");

    background-size: cover;

    background-position: center;

    background-attachment: fixed;
}


.quote p {

    font-family: var(--title);

    font-size: clamp(30px, 5vw, 65px);

    max-width: 900px;

    line-height: 1.1;
}


.quote span {

    display: block;

    color: var(--gold);

    margin-top: 30px;

    letter-spacing: 3px;

    font-size: 12px;
}


/* =========================
   GALERÍA
========================= */

.gallery {

    background: var(--dark);
}


.gallery-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    grid-auto-rows: 300px;

    gap: 15px;
}


.gallery-item {

    overflow: hidden;
}


.gallery-item.large {

    grid-row: span 2;
}


.gallery-item img {

    transition: 0.6s;
}


.gallery-item:hover img {

    transform: scale(1.08);
}


/* =========================
   CONTACTO
========================= */

.contact {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 100px;

    background: var(--black);
}


.contact-info > p:not(.section-label) {

    color: var(--gray);

    margin: 25px 0;
}


.contact-details {

    margin-top: 35px;
}


.contact-details p {

    margin: 12px 0;

    color: #ddd;
}


.contact-form {

    display: flex;

    flex-direction: column;

    gap: 15px;
}


.contact-form input,
.contact-form select,
.contact-form textarea {

    width: 100%;

    padding: 17px;

    background: var(--dark-2);

    border: 1px solid var(--border);

    color: white;

    font-family: var(--body);

    outline: none;
}


.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus {

    border-color: var(--gold);
}


.contact-form textarea {

    resize: vertical;
}


.contact-form .btn {

    border: none;
}


/* =========================
   FOOTER
========================= */

footer {

    padding: 50px 7%;

    text-align: center;

    background: #050505;

    border-top: 1px solid var(--border);
}


.footer-logo {

    width: 70px;

    height: 70px;

    margin: auto auto 20px;
}


footer p {

    font-family: var(--title);

    font-size: 20px;

    margin-bottom: 10px;
}


footer span {

    color: var(--gray);

    font-size: 13px;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {

    .nav {

        display: none;
    }


    .header {

        padding: 0 5%;
    }


    section {

        padding: 80px 5%;
    }


    .about,
    .contact {

        grid-template-columns: 1fr;

        gap: 45px;
    }


    .services-grid {

        grid-template-columns: 1fr;
    }


    .section-image {

        height: 450px;
    }


    .gallery-grid {

        grid-template-columns: 1fr 1fr;

        grid-auto-rows: 250px;
    }

}


@media (max-width: 600px) {

    .header .btn {

        display: none;
    }


    .hero h1 {

        font-size: 52px;
    }


    .hero-text {

        font-size: 15px;
    }


    .hero-buttons {

        flex-direction: column;

        align-items: flex-start;
    }


    .gallery-grid {

        grid-template-columns: 1fr;

        grid-auto-rows: 300px;
    }


    .gallery-item.large {

        grid-row: span 1;
    }


    .section-image {

        height: 350px;
    }

}
