:root {

    --black: #070707;
    --black-soft: #101010;
    --dark: #151515;
    --dark-light: #1d1d1d;

    --white: #ffffff;
    --gray: #999999;
    --light-gray: #cccccc;

    --gold: #c8a45d;
    --gold-light: #e4c77d;

    --border: rgba(255,255,255,0.10);

    --title: "Playfair Display", serif;
    --body: "DM Sans", sans-serif;

}


/* =====================================
   RESET
===================================== */

* {

    margin: 0;
    padding: 0;
    box-sizing: border-box;

}


html {

    scroll-behavior: smooth;

}


body {

    background: var(--black);

    color: var(--white);

    font-family: var(--body);

    line-height: 1.6;

}


img {

    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;

}


a {

    color: inherit;

}


/* =====================================
   HEADER
===================================== */

.header {

    position: fixed;

    top: 0;
    left: 0;

    width: 100%;

    height: 82px;

    padding: 0 7%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    background: rgba(7,7,7,0.88);

    backdrop-filter: blur(18px);

    border-bottom: 1px solid var(--border);

    z-index: 1000;

}


.logo {

    width: 58px;
    height: 58px;

}


.nav {

    display: flex;

    gap: 35px;

}


.nav a {

    text-decoration: none;

    font-size: 13px;

    color: #ddd;

    position: relative;

    transition: .3s;

}


.nav a::after {

    content: "";

    position: absolute;

    left: 0;
    bottom: -7px;

    width: 0;

    height: 1px;

    background: var(--gold);

    transition: .3s;

}


.nav a:hover {

    color: var(--gold);

}


.nav a:hover::after {

    width: 100%;

}


.header-button {

    padding: 11px 22px;

    background: var(--gold);

    color: #080808;

    text-decoration: none;

    font-size: 12px;

    font-weight: 700;

    transition: .3s;

}


.header-button:hover {

    background: var(--gold-light);

    transform: translateY(-2px);

}


/* =====================================
   HERO
===================================== */

.hero {

    min-height: 100vh;

    position: relative;

    display: flex;

    align-items: center;

    background-image:
        url("../img/portada.jpg");

    background-size: cover;

    background-position: center;

}


.hero-overlay {

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.95),
            rgba(0,0,0,.55),
            rgba(0,0,0,.2)
        );

}


.hero-content {

    position: relative;

    z-index: 2;

    width: 90%;

    max-width: 1200px;

    margin: auto;

    padding-top: 80px;

}


.eyebrow,
.section-label {

    color: var(--gold);

    letter-spacing: 4px;

    font-size: 11px;

    font-weight: 700;

    margin-bottom: 20px;

}


.hero h1 {

    font-family: var(--title);

    font-size: clamp(55px, 8vw, 110px);

    line-height: .93;

    max-width: 900px;

    margin-bottom: 30px;

}


.hero h1 span {

    display: block;

    color: var(--gold);

}


.hero-description {

    max-width: 500px;

    color: #ddd;

    font-size: 17px;

    margin-bottom: 35px;

}


.hero-buttons {

    display: flex;

    gap: 15px;

    flex-wrap: wrap;

}


/* =====================================
   BUTTONS
===================================== */

.button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 15px 30px;

    border: 1px solid var(--gold);

    text-decoration: none;

    font-size: 13px;

    font-weight: 700;

    transition: .3s;

    cursor: pointer;

}


.button.primary {

    background: var(--gold);

    color: #080808;

}


.button.primary:hover {

    background: var(--gold-light);

    transform: translateY(-3px);

}


.button.secondary {

    background: transparent;

    color: white;

    border-color: rgba(255,255,255,.5);

}


.button.secondary:hover {

    background: white;

    color: black;

}


.hero-info {

    display: flex;

    gap: 45px;

    margin-top: 75px;

}


.hero-info div {

    display: flex;

    flex-direction: column;

    gap: 3px;

}


.hero-info strong {

    color: var(--gold);

    font-size: 13px;

}


.hero-info span {

    color: #bbb;

    font-size: 11px;

}


.hero-scroll {

    position: absolute;

    right: 5%;

    bottom: 40px;

    writing-mode: vertical-rl;

    font-size: 10px;

    letter-spacing: 3px;

    color: #aaa;

}


/* =====================================
   GENERAL SECTIONS
===================================== */

section {

    padding: 120px 7%;

}


.section-heading {

    text-align: center;

    max-width: 750px;

    margin: 0 auto 65px;

}


.section-heading h2,
.about-content h2,
.booking-content h2,
.contact h2 {

    font-family: var(--title);

    font-size: clamp(40px, 5vw, 68px);

    line-height: 1.05;

}


.section-heading h2 span,
.about-content h2 span,
.booking-content h2 span,
.contact h2 span {

    color: var(--gold);

}


.section-heading > p:last-child {

    color: var(--gray);

    margin-top: 20px;

}


/* =====================================
   ABOUT
===================================== */

.about {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 90px;

    align-items: center;

    background: var(--black-soft);

}


.about-image {

    height: 600px;

    position: relative;

}


.about-image img {

    filter: grayscale(15%);

}


.experience-box {

    position: absolute;

    right: -30px;

    bottom: 30px;

    padding: 25px 30px;

    background: var(--gold);

    color: #080808;

    display: flex;

    align-items: center;

    gap: 15px;

}


.experience-box strong {

    font-family: var(--title);

    font-size: 42px;

}


.experience-box span {

    font-size: 11px;

    line-height: 1.4;

}


.about-content > p:not(.section-label) {

    color: var(--gray);

    max-width: 570px;

    margin: 25px 0;

}


.about-features {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 15px;

    margin: 35px 0;

}


.about-features div {

    color: #ddd;

    font-size: 13px;

}


.about-features span {

    color: var(--gold);

    margin-right: 8px;

}


.text-button {

    color: var(--gold);

    text-decoration: none;

    font-weight: 700;

    font-size: 13px;

}


/* =====================================
   SERVICES
===================================== */

.services {

    background: var(--black);

}


.services-grid {

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 20px;

}


.service-card {

    background: var(--dark);

    border: 1px solid var(--border);

    transition: .4s;

}


.service-card:hover {

    transform: translateY(-10px);

    border-color: var(--gold);

}


.service-image {

    height: 310px;

    position: relative;

    overflow: hidden;

}


.service-image img {

    transition: .6s;

}


.service-card:hover img {

    transform: scale(1.08);

}


.service-number {

    position: absolute;

    top: 18px;

    left: 18px;

    color: white;

    font-size: 11px;

    letter-spacing: 2px;

}


.popular {

    position: absolute;

    right: 15px;

    top: 15px;

    background: var(--gold);

    color: black;

    padding: 6px 9px;

    font-size: 8px;

    font-weight: 700;

}


.service-content {

    padding: 25px;

}


.service-content h3 {

    font-family: var(--title);

    font-size: 25px;

    margin-bottom: 10px;

}


.service-content p {

    color: var(--gray);

    font-size: 13px;

    min-height: 80px;

}


.service-bottom {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-top: 20px;

    padding-top: 20px;

    border-top: 1px solid var(--border);

}


.service-bottom strong {

    color: var(--gold);

}


.service-bottom a {

    color: white;

    text-decoration: none;

    font-size: 11px;

    font-weight: 700;

}


/* =====================================
   QUOTE
===================================== */

.quote {

    min-height: 500px;

    display: flex;

    justify-content: center;

    align-items: center;

    text-align: center;

    background:
        linear-gradient(
            rgba(0,0,0,.82),
            rgba(0,0,0,.82)
        ),
        url("../img/portada.jpg");

    background-size: cover;

    background-position: center;

    background-attachment: fixed;

}


.quote p {

    font-family: var(--title);

    font-size: clamp(35px, 6vw, 75px);

    line-height: 1;

    max-width: 1000px;

}


.quote p span {

    color: var(--gold);

}


.quote small {

    display: block;

    margin-top: 30px;

    color: var(--gold);

    letter-spacing: 4px;

}


/* =====================================
   GALLERY
===================================== */

.gallery {

    background: var(--black-soft);

}


.gallery-grid {

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    grid-auto-rows: 300px;

    gap: 15px;

}


.gallery-item {

    position: relative;

    overflow: hidden;

}


.gallery-item.big {

    grid-column: span 2;

    grid-row: span 2;

}


.gallery-item img {

    transition: .6s;

}


.gallery-item:hover img {

    transform: scale(1.08);

}


.gallery-overlay {

    position: absolute;

    left: 0;
    bottom: 0;

    width: 100%;

    padding: 20px;

    background: linear-gradient(
        transparent,
        rgba(0,0,0,.9)
    );

    color: white;

    font-size: 11px;

    letter-spacing: 2px;

}


/* =====================================
   TESTIMONIALS
===================================== */

.testimonials {

    background: var(--black);

}


.testimonial-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;

}


.testimonial {

    background: var(--dark);

    border: 1px solid var(--border);

    padding: 35px;

}


.stars {

    color: var(--gold);

    letter-spacing: 4px;

    margin-bottom: 20px;

}


.testimonial p {

    color: #ccc;

    font-size: 14px;

    margin-bottom: 25px;

}


.testimonial strong {

    font-size: 11px;

    color: var(--gold);

}


/* =====================================
   BOOKING
===================================== */

.booking {

    display: grid;

    grid-template-columns: .9fr 1.1fr;

    gap: 90px;

    background:

        linear-gradient(
            90deg,
            rgba(10,10,10,.96),
            rgba(10,10,10,.90)
        ),
        url("../img/local.jpg");

    background-size: cover;

    background-position: center;

}


.booking-content > p:not(.section-label) {

    color: var(--gray);

    max-width: 500px;

    margin: 25px 0;

}


.booking-benefits {

    display: flex;

    flex-direction: column;

    gap: 12px;

    color: #ddd;

    font-size: 13px;

    margin-top: 35px;

}


.booking-benefits span::first-letter {

    color: var(--gold);

}


.booking-form {

    background: rgba(20,20,20,.8);

    border: 1px solid var(--border);

    padding: 40px;

    backdrop-filter: blur(10px);

}


.input-group {

    display: flex;

    flex-direction: column;

    gap: 8px;

}


.input-group label {

    font-size: 11px;

    color: #aaa;

    letter-spacing: 1px;

}


.input-group input,
.input-group select,
.input-group textarea {

    width: 100%;

    padding: 15px;

    background: #0b0b0b;

    border: 1px solid var(--border);

    color: white;

    outline: none;

    font-family: var(--body);

}


.input-group input:focus,
.input-group select:focus,
.input-group textarea:focus {

    border-color: var(--gold);

}


.input-group textarea {

    resize: vertical;

}


.booking-form {

    display: flex;

    flex-direction: column;

    gap: 18px;

}


.form-row {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 15px;

}


.button.full {

    width: 100%;

    border: none;

}


.form-note {

    color: #777;

    font-size: 10px;

    text-align: center;

}


/* =====================================
   CONTACT
===================================== */

.contact {

    display: grid;

    grid-template-columns: .7fr 1.3fr;

    gap: 80px;

    background: var(--dark);

}


.contact-grid {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 15px;

}


.contact-card {

    display: flex;

    align-items: flex-start;

    gap: 18px;

    padding: 25px;

    background: var(--black);

    border: 1px solid var(--border);

    text-decoration: none;

    transition: .3s;

}


.contact-card:hover {

    border-color: var(--gold);

    transform: translateY(-4px);

}


.contact-card > span {

    font-size: 20px;

}


.contact-card strong {

    font-size: 13px;

}


.contact-card p {

    color: var(--gray);

    font-size: 12px;

    margin-top: 5px;

}


.whatsapp {

    background: #111;

}


/* =====================================
   FOOTER
===================================== */

footer {

    padding: 70px 7% 35px;

    text-align: center;

    background: #050505;

    border-top: 1px solid var(--border);

}


.footer-logo {

    width: 70px;

    height: 70px;

    margin: 0 auto 20px;

}


footer h3 {

    font-family: var(--title);

    font-size: 24px;

}


footer > p {

    color: var(--gold);

    font-size: 11px;

    letter-spacing: 3px;

    margin-top: 8px;

}


.socials {

    display: flex;

    justify-content: center;

    gap: 25px;

    margin: 30px 0;

}


.socials a {

    color: #aaa;

    font-size: 12px;

    text-decoration: none;

}


.socials a:hover {

    color: var(--gold);

}


.copyright {

    color: #555;

    font-size: 10px;

}


/* =====================================
   WHATSAPP FLOATING
===================================== */

.floating-whatsapp {

    position: fixed;

    right: 25px;

    bottom: 25px;

    width: 58px;

    height: 58px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #25D366;

    border-radius: 50%;

    text-decoration: none;

    font-size: 25px;

    z-index: 999;

    box-shadow: 0 5px 25px rgba(0,0,0,.5);

    transition: .3s;

}


.floating-whatsapp:hover {

    transform: scale(1.1);

}


/* =====================================
   RESPONSIVE
===================================== */

@media (max-width: 1100px) {

    .services-grid {

        grid-template-columns: repeat(2, 1fr);

    }


    .gallery-grid {

        grid-template-columns: repeat(2, 1fr);

    }


    .gallery-item.big {

        grid-column: span 2;

    }

}


@media (max-width: 850px) {

    .header {

        padding: 0 5%;

    }


    .nav {

        gap: 15px;

    }


    .nav a {

        font-size: 11px;

    }


    .header-button {

        display: none;

    }


    section {

        padding: 85px 5%;

    }


    .about,
    .booking,
    .contact {

        grid-template-columns: 1fr;

        gap: 50px;

    }


    .about-image {

        height: 450px;

    }


    .experience-box {

        right: 15px;

    }


    .testimonial-grid {

        grid-template-columns: 1fr;

    }


    .contact-grid {

        grid-template-columns: 1fr 1fr;

    }

}


@media (max-width: 600px) {

    .header {

        height: 70px;

    }


    .logo {

        width: 48px;
        height: 48px;

    }


    .nav {

        gap: 9px;

    }


    .nav a {

        font-size: 9px;

    }


    .hero-content {

        padding-top: 50px;

    }


    .hero h1 {

        font-size: 51px;

    }


    .hero-description {

        font-size: 14px;

    }


    .hero-info {

        gap: 18px;

        margin-top: 50px;

    }


    .hero-info span {

        font-size: 9px;

    }


    .services-grid {

        grid-template-columns: 1fr;

    }


    .gallery-grid {

        grid-template-columns: 1fr;

        grid-auto-rows: 300px;

    }


    .gallery-item.big {

        grid-column: span 1;

        grid-row: span 1;

    }


    .form-row {

        grid-template-columns: 1fr;

    }


    .booking-form {

        padding: 25px;

    }


    .contact-grid {

        grid-template-columns: 1fr;

    }


    .about-features {

        grid-template-columns: 1fr;

    }


    .floating-whatsapp {

        width: 52px;
        height: 52px;

        right: 18px;
        bottom: 18px;

    }

}
```
